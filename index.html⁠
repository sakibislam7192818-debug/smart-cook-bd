<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IGT Gas Safety Device - SmartCook BD</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #f0f2f5;
            color: #333;
            line-height: 1.6;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            min-height: 100vh;
        }
        .top-bar {
            background: #111;
            color: #fff;
            text-align: center;
            padding: 8px 15px;
            font-size: 13px;
            font-weight: 600;
        }
        .header {
            background: linear-gradient(135deg, #d9534f, #b52b27);
            color: white;
            text-align: center;
            padding: 25px 20px;
        }
        .header h1 {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .header p {
            font-size: 14px;
            opacity: 0.95;
        }
        .badge {
            display: inline-block;
            background: #ffc107;
            color: #000;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 10px;
            text-transform: uppercase;
        }
        .content {
            padding: 20px;
        }
        .product-img {
            width: 100%;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid #eee;
            margin-bottom: 15px;
        }
        .price-card {
            background: #fff8f8;
            border: 2px solid #ffdddd;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            margin-bottom: 20px;
        }
        .regular-price {
            text-decoration: line-through;
            color: #888;
            font-size: 16px;
            margin-right: 10px;
        }
        .offer-price {
            color: #d9534f;
            font-size: 26px;
            font-weight: 800;
        }
        .save-tag {
            display: block;
            margin-top: 5px;
            font-size: 13px;
            color: #28a745;
            font-weight: 600;
        }
        .features {
            background: #f8fdf9;
            border: 1px solid #d4edda;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 25px;
        }
        .features h3 {
            color: #155724;
            font-size: 18px;
            margin-bottom: 12px;
            border-bottom: 2px solid #c3e6cb;
            padding-bottom: 5px;
        }
        .features ul {
            list-style: none;
        }
        .features li {
            position: relative;
            padding-left: 25px;
            margin-bottom: 10px;
            font-size: 15px;
        }
        .features li::before {
            content: "✔";
            position: absolute;
            left: 0;
            color: #28a745;
            font-weight: bold;
            font-size: 16px;
        }
        .order-box {
            background: #ffffff;
            border: 2px solid #28a745;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.12);
        }
        .order-box h2 {
            text-align: center;
            color: #28a745;
            font-size: 20px;
            margin-bottom: 15px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
            font-size: 14px;
        }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
            outline: none;
            transition: 0.2s;
        }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
            border-color: #28a745;
        }
        .total-box {
            background: #f8f9fa;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 15px;
            font-size: 15px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            color: #333;
        }
        .btn-order {
            width: 100%;
            background: #28a745;
            color: #fff;
            border: none;
            padding: 16px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(40, 167, 69, 0.3);
        }
        .btn-order:active {
            transform: scale(0.99);
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 13px;
            color: #777;
            border-top: 1px solid #eee;
            margin-top: 25px;
        }
        .success-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 9999;
        }
        .success-card {
            background: #fff;
            padding: 30px 20px;
            border-radius: 12px;
            text-align: center;
            max-width: 400px;
            width: 100%;
        }
        .success-card h2 {
            color: #28a745;
            margin-bottom: 10px;
        }
        .btn-close {
            margin-top: 20px;
            padding: 10px 20px;
            background: #d9534f;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="top-bar">
        🚚 সারা বাংলাদেশে ক্যাশ অন ডেলিভারি সুবিধা
    </div>

    <div class="header">
        <span class="badge">অরিজিনাল ডেনমার্ক প্রযুক্তি</span>
        <h1>IGT Gas Safety Device</h1>
        <p>আপনার পরিবারকে রাখুন গ্যাস দুর্ঘটনা থেকে ১০০% নিরাপদ</p>
    </div>

    <div class="content">
        <img src="igt-regulator.jpg" alt="IGT Gas Safety Device" class="product-img" onerror="this.src='https://via.placeholder.com/600x350?text=IGT+Gas+Safety+Device'">

        <div class="price-card">
            <span class="regular-price">রেগুলার প্রাইস: ২৫০০ টাকা</span>
            <span class="offer-price">অফার প্রাইস: ১৪৫০ টাকা</span>
            <span class="save-tag">আজই অর্ডার করলে পাচ্ছেন ১০৫০ টাকা ছাড়!</span>
        </div>

        <div class="features">
            <h3>কেন এই ডিভাইসটি ব্যবহার করবেন?</h3>
            <ul>
                <li>গ্যাস পাইপ লিক হলে বা কেটে গেলে স্বয়ংক্রিয়ভাবে গ্যাস সরবরাহ বন্ধ হয়ে যায়।</li>
                <li>৩০% থেকে ৪০% পর্যন্ত গ্যাস সাশ্রয় করে।</li>
                <li>মিটারের সাহায্যে সিলিন্ডারের গ্যাসের পরিমাণ সহজেই দেখা যায়।</li>
                <li>সহজ সেটআপ - যেকোনো সিলিন্ডারে নিজে নিজেই ফিট করতে পারবেন।</li>
                <li>১০০% অরিজিনাল ও ৫ বছরের গ্যারান্টি।</li>
            </ul>
        </div>

        <div class="order-box">
            <h2>অর্ডার করতে নিচের ফর্মটি পূরণ করুন</h2>
            <form id="orderForm" onsubmit="submitOrder(event)">
                <div class="form-group">
                    <label for="name">আপনার নাম *</label>
                    <input type="text" id="name" required placeholder="আপনার পূর্ণ নাম">
                </div>

                <div class="form-group">
                    <label for="phone">মোবাইল নম্বর *</label>
                    <input type="tel" id="phone" required placeholder="১১ ডিজিটের মোবাইল নম্বর">
                </div>

                <div class="form-group">
                    <label for="address">সম্পূর্ণ ঠিকানা *</label>
                    <textarea id="address" rows="2" required placeholder="গ্রাম/রাস্তা, থানা, জেলা"></textarea>
                </div>

                <div class="form-group">
                    <label for="delivery">ডেলিভারি এরিয়া *</label>
                    <select id="delivery" onchange="calculateTotal()" required>
                        <option value="80">ঢাকার ভেতরে (৮০ টাকা)</option>
                        <option value="150">ঢাকার বাইরে (১৫০ টাকা)</option>
                    </select>
                </div>

                <div class="total-box">
                    <span>সর্বমোট মূল্য:</span>
                    <span id="totalPrice">১৫৩০ টাকা</span>
                </div>

                <button type="submit" class="btn-order">অর্ডার নিশ্চিত করুন</button>
            </form>
        </div>
    </div>

    <div class="footer">
        <p>SmartCook BD | যেকোনো সহায়তার জন্য কল করুন: 01700000000</p>
    </div>
</div>

<div class="success-modal" id="successModal">
    <div class="success-card">
        <h2>✔ অর্ডার সফল হয়েছে!</h2>
        <p>ধন্যবাদ! আপনার অর্ডারটি আমরা পেয়েছি। আমাদের প্রতিনিধি খুব শীঘ্রই আপনার সাথে যোগাযোগ করবেন।</p>
        <button class="btn-close" onclick="closeModal()">ঠিক আছে</button>
    </div>
</div>

<script>
    const productPrice = 1450;

    function calculateTotal() {
        const deliveryCharge = parseInt(document.getElementById('delivery').value);
        const total = productPrice + deliveryCharge;
        document.getElementById('totalPrice').innerText = total + ' টাকা';
    }

    function submitOrder(e) {
        e.preventDefault();
        document.getElementById('successModal').style.display = 'flex';
        document.getElementById('orderForm').reset();
        calculateTotal();
    }

    function closeModal() {
        document.getElementById('successModal').style.display = 'none';
    }
</script>

</body>
</html>
